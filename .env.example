# =============================================================================
# Btc_trading_agents — Docker environment variables
# =============================================================================
# Copy this file to .env and customize values.
# docker-compose reads .env automatically.
# =============================================================================

# ── Execution mode ─────────────────────────────────────────────────────────
# "historical" = replay OHLCV data through the full stack (backtest)
# "live"       = continuous polling of live exchange (requires credentials)
TRADING_MODE=historical

# ── Config environment ─────────────────────────────────────────────────────
# "paper"      = Binance sandbox + paper_sim execution (no real money)
# "live"       = real exchange + real execution (requires confirm_real_money=true)
TRADING_ENV=paper

# ── Historical backtest ────────────────────────────────────────────────────
# Path to OHLCV CSV or Parquet file (relative to container: /opt/trading-agent/data/raw/)
# Mount your data with: -v /host/path:/opt/trading-agent/data/raw
# Example: INPUT_DATA=/opt/trading-agent/data/raw/BTCUSDT.csv
INPUT_DATA=

# ── Trading pair ───────────────────────────────────────────────────────────
SYMBOL=BTC/USDT

# ── Historical backtest limits ─────────────────────────────────────────────
# Maximum bars to process (omit or 0 = all bars)
MAX_BARS=

# Starting equity for backtest PnL calculation
INITIAL_EQUITY=10000

# ── Live mode credentials ──────────────────────────────────────────────────
# Only needed for TRADING_ENV=live with real orders
# API keys are read from environment by CCXT, never stored in config files
BTC_BOT_API_KEY=
BTC_BOT_API_SECRET=

# ── Network resilience ─────────────────────────────────────────────────────
# Max retries when exchange is unreachable (live mode)
NETWORK_RETRY_MAX=5
# Base delay in seconds before first retry
NETWORK_RETRY_BASE_DELAY=10
# Backoff multiplier (delay doubles each retry: 10s, 20s, 40s, ...)
NETWORK_RETRY_BACKOFF=2

# ── Graceful shutdown ──────────────────────────────────────────────────────
# Seconds to wait for the trading agent to finish current bar before force-killing
SHUTDOWN_TIMEOUT=30
